# Copy to .env; start-from-docker.sh sources this file automatically.
# For local startup, export first: set -a; . ./.env; set +a

# Local server settings. Docker fixes transport=http, host=0.0.0.0, port=9110.
MARABRAIN_TRANSPORT=stdio
MARABRAIN_HOST=127.0.0.1
MARABRAIN_PORT=9110
MARABRAIN_LOG_LEVEL=info

# Required for HTTP and Docker: set a random secret of at least 32 characters.
# Shared bearer is for a trusted backend. Authenticate tenants and authorize workspace
# membership there before supplying workspace_id; the ID routes work, not authorization.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
MARABRAIN_BEARER_SECRET=
# Alternative: absolute host path, readable by container UID/GID 65532.
MARABRAIN_BEARER_SECRET_FILE=

# JSON arrays. Retain 127.0.0.1 for the Docker healthcheck.
MARABRAIN_ALLOWED_HOSTS='["127.0.0.1","localhost","[::1]"]'
MARABRAIN_ALLOWED_ORIGINS='[]'
# Unset allows every domain; uncomment [] to deny all memory operations.
# This common policy applies within each workspace; it does not authorize membership.
# MARABRAIN_ALLOWED_DOMAINS='[]'
# health takes no arguments: all activated engines share one total probe deadline.
# Zero activated workspaces means service ready; health does not assure embeddings readiness.
MARABRAIN_HEALTH_TIMEOUT_SECONDS=2
MARABRAIN_COMMAND_TIMEOUT_SECONDS=30
MARABRAIN_ENGINE_STARTUP_TIMEOUT_SECONDS=30
# Optional independent total budgets in seconds; empty or unset disables each.
# Configured values must be positive and finite; existing caps still apply.
# Startup total covers each workspace activation, including readiness and registry sync.
MARABRAIN_STARTUP_TIMEOUT_SECONDS=
# Operation total includes activation wait, registry work and final CLI; LLM is separate.
MARABRAIN_OPERATION_TIMEOUT_SECONDS=
# Optional integer limits; empty or unset preserves unbounded behavior.
# Application-wide capacity C >= 2 across workspaces: C-1 data and 1 control helper.
# Saturation fails immediately; persistent daemons and LLM calls are excluded.
# Daemon count grows with activated workspaces; budget memory/model copies per workspace.
MARABRAIN_MAX_TRANSIENT_PROCESSES=
# Positive raw stdout bytes per captured child; overflow fails without truncation.
# Parsed objects, daemon diagnostics and LLM responses are outside this ceiling.
MARABRAIN_MAX_CAPTURE_BYTES=
# Uniform positive integer final-command capacity per workspace and resolved domain pair.
# Unset or empty disables domain quotas; global lanes still apply.
# Aliases share the resolved name within a workspace; registry commands and LLM are excluded.
MARABRAIN_DOMAIN_COMMAND_CAPACITY=
# MARABRAIN_DOMAIN_COMMAND_CAPACITY=2
# Local default is external; Docker's default command uses managed.
# Managed launches a dedicated daemon lazily on each workspace's first memory request.
# External requires a dedicated preprovisioned daemon on each workspace's paths, never base paths.
# Both require engine readiness before registry synchronization and memory operations.
MARABRAIN_ENGINE_MODE=external

# Every memory tool requires workspace_id, a case-sensitive ASCII string of 1-64 characters:
# first alphanumeric, then alphanumeric, underscore or hyphen. No default/normalization/adoption.
# Optional absolute root; default: captured XDG_STATE_HOME/marabrain/workspaces
# (HOME/.local/state/marabrain/workspaces without XDG_STATE_HOME).
# MARABRAIN_WORKSPACE_ROOT=/absolute/path/to/workspaces
# Workspace subdirectories use hashed tokens and exact identity records; do not hardcode layout.
# External provisioning: call prepare_workspace(workspace_id, root) first to bind the identity.
# EngineContext.capture().for_workspace(workspace_id, root) provides the private environment.
# Each owns separate HOME/XDG/config/database/socket/domains/registry/admission state.
# Directories must be private, writable, owned by the server user, with no symlink components.
# Full Unix socket path max: 103 bytes macOS, 107 Linux. Use a short root; no fallback relocation.
# Base CRYSTALLINE_* overrides are removed; base config is not copied into workspaces.
# Preserve legacy data and determine tenant ownership before explicit per-tenant migration.
# Legacy data is unassigned/unreachable; no automatic migration. Shutdown leaves data in place.

# Docker launcher settings. The published host port is bound to 127.0.0.1.
MARABRAIN_IMAGE=marabrain:latest
MARABRAIN_CONTAINER=marabrain
MARABRAIN_HOST_PORT=9110
# Named Docker volume at /data; default workspace root is /data/state/marabrain/workspaces.
# Persists each workspace's config, state and cache; keep custom container roots under /data.
MARABRAIN_DATA_VOLUME=marabrain-data

# Remote embedding configuration/bootstrap runs per workspace on activation.
# Provider/bootstrap failures surface on first activation; base config.yaml is never rewritten.
EMBEDDING_MODEL="nvidia/nemotron-3.5-embed-1b:free" # nvidia/nemotron-3.5-embed-8b:free -> 4096, nvidia/nemotron-3.5-embed-1b:free -> 2048, qwen/qwen3-embedding-4b -> 2560
EMBEDDING_DIMS=2048
EMBEDDING_PROVIDER_URL="https://openrouter.ai/api/v1"
EMBEDDING_API_KEY=
# Alternative to EMBEDDING_API_KEY; absolute host path readable by UID/GID 65532.
EMBEDDING_API_KEY_FILE=

# Optional read_memory(workspace_id, domain, permalink, compress=false, query=None) compression.
# compress=true requires a nonempty, non-whitespace query and sends the full memory
# content and query to the LLM provider; normal reads do not call the LLM.
# It replaces returned content with distilled context and adds compressed: true.
# The original checksum remains the source checksum; the source memory is never written.
# Compression does not affect normal reads or search_memories; search has no compression option.
# Choose a text-generation model, not an embedding model. Leave model/base blank
# when unused. Use a versioned OpenAI API base or a Claude gateway root, without endpoint paths.
LLM_MODEL=
LLM_PROVIDER_URL=
# Required for Anthropic; optional only for keyless OpenAI-compatible hosts.
LLM_API_KEY=
LLM_PROVIDER=openai
# Optional low, medium, or high; the selected model must support effort.
LLM_REASONING_EFFORT=
# Optional 0..2 for OpenAI; omit if unsupported by the model.
# Leave empty for Claude: claude-agent-sdk does not expose temperature.
LLM_TEMPERATURE=
# Claude Agent SDK's assumed context window; not a hard pre-dispatch input cap.
# OpenAI-compatible Chat Completions uses the selected model's context window.
LLM_MAX_INPUT_TOKENS=256000
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_SECONDS=60
# Uniform compression cache limits per workspace and resolved domain pair.
# Both unset/empty disables caching; otherwise both must be positive integers.
# Every hit reads the source; keys, shared requests and buckets include workspace and domain.
# Entries are private to this application/workspace/domain; provider disclosure is unchanged.
# LRU eviction bounds payload only, excluding keys, overhead and in-flight requests.
LLM_COMPRESSION_CACHE_MAX_ENTRIES=
LLM_COMPRESSION_CACHE_MAX_BYTES=
# LLM_COMPRESSION_CACHE_MAX_ENTRIES=64
# LLM_COMPRESSION_CACHE_MAX_BYTES=1048576

# OpenAI example: set LLM_API_KEY separately to your provider credential.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# LLM_PROVIDER_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=0.2

# Anthropic example: set LLM_API_KEY separately to your Anthropic credential.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_PROVIDER_URL=https://api.anthropic.com
# For effort, choose a Claude model that supports adaptive thinking,
# then set LLM_REASONING_EFFORT=medium.
